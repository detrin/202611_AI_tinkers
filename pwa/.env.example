# Where Dan's FastAPI backend runs. The dev and preview servers forward /api/* there.
BACKEND_URL=http://localhost:8000
# Optional: the backend's TODAY_API_TOKEN. With it the app uses the agent endpoint (calendar, hourly weather,
# commute, venue). Without it the app uses the simpler /outfits/daily. Ask Dan or Dima.
TODAY_API_TOKEN=
# Optional: prefill the user id so the app opens ready. Ask Dan for the seeded test user.
VITE_USER_ID=
